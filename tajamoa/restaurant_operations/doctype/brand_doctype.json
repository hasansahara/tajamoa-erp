{
  "name": "Brand",
  "module": "Restaurant Operations",
  "doctype": "DocType",
  "is_submittable": 0,
  "track_changes": 1,
  "naming_rule": "By fieldname",
  "autoname": "field:brand_code",
  "title_field": "brand_name",
  "description": "A restaurant brand or cloud kitchen under the group",
  "fields": [
    {
      "fieldname": "brand_section",
      "fieldtype": "Section Break",
      "label": "Brand Identity"
    },
    {
      "fieldname": "brand_name",
      "fieldtype": "Data",
      "label": "Brand Name",
      "reqd": 1,
      "in_list_view": 1,
      "translatable": 1
    },
    {
      "fieldname": "brand_name_ar",
      "fieldtype": "Data",
      "label": "اسم البراند (عربي)",
      "translatable": 0
    },
    {
      "fieldname": "brand_code",
      "fieldtype": "Data",
      "label": "Brand Code",
      "reqd": 1,
      "unique": 1,
      "description": "Short code e.g. EGG, SAL, AM, CC, EAGLE, DIAFA, ROWAD",
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "brand_logo",
      "fieldtype": "Attach Image",
      "label": "Brand Logo"
    },
    {
      "fieldname": "brand_color",
      "fieldtype": "Color",
      "label": "Brand Color (POS Tab)"
    },
    {
      "fieldname": "company_section",
      "fieldtype": "Section Break",
      "label": "Company & Accounting"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "cost_center",
      "fieldtype": "Link",
      "label": "Cost Center",
      "options": "Cost Center",
      "reqd": 1,
      "description": "The cost center for this brand's transactions"
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "income_account",
      "fieldtype": "Link",
      "label": "Default Income Account",
      "options": "Account"
    },
    {
      "fieldname": "pos_section",
      "fieldtype": "Section Break",
      "label": "POS Settings"
    },
    {
      "fieldname": "pos_profile",
      "fieldtype": "Link",
      "label": "Default POS Profile",
      "options": "POS Profile",
      "description": "The POS this brand appears in"
    },
    {
      "fieldname": "display_order",
      "fieldtype": "Int",
      "label": "Tab Display Order",
      "default": "0",
      "description": "Order of brand tab in the POS screen"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "kitchen_printer",
      "fieldtype": "Data",
      "label": "Kitchen Printer IP/Name",
      "description": "Printer used for kitchen tickets"
    },
    {
      "fieldname": "receipt_printer",
      "fieldtype": "Data",
      "label": "Receipt Printer IP/Name"
    },
    {
      "fieldname": "type_section",
      "fieldtype": "Section Break",
      "label": "Brand Type"
    },
    {
      "fieldname": "brand_type",
      "fieldtype": "Select",
      "label": "Brand Type",
      "options": "Main Restaurant\nCloud Kitchen\nBakery\nCafe",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "parent_brand",
      "fieldtype": "Link",
      "label": "Parent Brand",
      "options": "Brand",
      "description": "For cloud kitchens: the main brand they operate under"
    },
    {
      "fieldname": "col_break_4",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active",
      "default": "1"
    },
    {
      "fieldname": "jareb_brand_id",
      "fieldtype": "Data",
      "label": "Jareb Tech Brand ID",
      "description": "ID used to sync with Jareb Tech delivery aggregator"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Company CFO",
      "read": 1, "write": 1, "create": 1
    },
    {
      "role": "Brand Manager",
      "read": 1, "write": 1
    },
    {
      "role": "Cashier",
      "read": 1
    }
  ]
}
