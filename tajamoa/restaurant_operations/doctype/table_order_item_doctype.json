{
  "name": "Table Order Item",
  "module": "Restaurant Operations",
  "doctype": "DocType",
  "istable": 1,
  "fields": [
    {
      "fieldname": "menu_item",
      "fieldtype": "Link",
      "label": "Menu Item",
      "options": "Menu Item",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "item_name_ar",
      "fieldtype": "Data",
      "label": "الاسم",
      "fetch_from": "menu_item.display_name_ar",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "الكمية",
      "default": "1",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "unit_price",
      "fieldtype": "Currency",
      "label": "السعر",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "modifiers_total",
      "fieldtype": "Currency",
      "label": "إضافات",
      "default": "0",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "line_total",
      "fieldtype": "Currency",
      "label": "الإجمالي",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "modifiers_json",
      "fieldtype": "Long Text",
      "label": "Selected Modifiers (JSON)",
      "description": "Stored as JSON: [{group, group_name_ar, option, option_name_ar, price_addition}]",
      "hidden": 0
    },
    {
      "fieldname": "modifiers_display",
      "fieldtype": "Small Text",
      "label": "الإضافات (للعرض)",
      "read_only": 1,
      "description": "Human-readable summary of modifiers"
    },
    {
      "fieldname": "item_notes",
      "fieldtype": "Data",
      "label": "ملاحظات الصنف",
      "description": "e.g. بدون بصل، صوص على الجانب"
    },
    {
      "fieldname": "kitchen_station",
      "fieldtype": "Data",
      "label": "Kitchen Station",
      "fetch_from": "menu_item.kitchen_station",
      "read_only": 1
    },
    {
      "fieldname": "kds_status",
      "fieldtype": "Select",
      "label": "KDS Status",
      "options": "Pending\nIn Progress\nReady\nServed",
      "default": "Pending"
    }
  ]
}
